# Server-only configuration. DEMO_MODE=true serves synthetic data WITHOUT authentication for UI review;
# the server refuses to start with it when NODE_ENV=production. Never use a NEXT_PUBLIC_ prefix for it.
DEMO_MODE=false
DATABASE_URL=postgresql://nyayaflow_app:change-me@127.0.0.1:5432/nyayaflow
DATABASE_ADMIN_URL=postgresql://nyayaflow_owner:change-me@127.0.0.1:5432/nyayaflow
WORKER_DATABASE_URL=postgresql://nyayaflow_worker:change-me@127.0.0.1:5432/nyayaflow
DATABASE_SSL=false
SESSION_COOKIE_NAME=nf_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
DOCUMENT_STORAGE_ROOT=/var/lib/nyayaflow/documents
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ENABLED=false
OPENAI_ALLOWED_CLASSIFICATIONS=public,synthetic,redacted
# Research Beta is disabled unless a source administrator enables rights-cleared authority sources.
# Neo4j is an optional, rebuildable projection of public authority metadata only—never firm data.
RESEARCH_ENABLED=false
RESEARCH_FIXTURES_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=nyayaflow_graph
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# BNS/BNSS/BSA mapping corpus. Leave disabled until reviewed sources are loaded.
BNS_TRANSITION_ENABLED=false
BNS_FIXTURES_ENABLED=false
# E-Filing and Contracts & CLM are internal manual-only betas. Enable only with source-recorded
# firm data; the optional fixture loader is development-only and marks everything fictional.
FILING_BETA_ENABLED=false
CONTRACTS_BETA_ENABLED=false
FILING_FIXTURES_ENABLED=false
CONTRACTS_FIXTURES_ENABLED=false
BETA_FIXTURE_ORGANIZATION_SLUG=
APP_BASE_URL=http://localhost:3000
# Comma-separated hostnames allowed to load Next.js development assets, e.g. a temporary tunnel.
DEV_ALLOWED_ORIGINS=
# Tesseract traineddata must be installed for each enabled code: eng, hin, mar, guj, tam, tel, ben, kan, pan.
OCR_LANGUAGES=eng+hin+mar+guj+tam+tel+ben+kan+pan
WORKER_POLL_MS=3000
MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_PAGES=500

# Razorpay is inactive until all three server-only values are supplied. Use separate test and production credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email delivery is deliberately SMTP-only; no WhatsApp or SMS provider is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only by `npm run db:provision`; do not keep OPERATOR_PASSWORD in the service environment.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
OPERATOR_NAME=
ORGANIZATION_NAME=
ORGANIZATION_SLUG=

# Platform superadmin console (/platform). Generate with: npm run superadmin:setup -- you@example.in --write .env
# The console stays disabled (404) unless all three are set. The hash is base64url-encoded Argon2id.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=
SUPERADMIN_TOTP_SECRET=
