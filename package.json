{
  "name": "nyayaflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:provision": "tsx scripts/provision-operator.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx worker/index.ts",
    "test:integration": "bash scripts/test-db.sh",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=cjs --target=node24 --external:pg-native --outfile=.worker-build/worker.cjs && esbuild scripts/migrate.ts scripts/provision-operator.ts --bundle --platform=node --format=cjs --target=node24 --external:pg-native --external:argon2 --outdir=.worker-build/scripts --out-extension:.js=.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "argon2": "^0.44.0",
    "lucide-react": "^0.544.0",
    "next": "^16.0.0",
    "openai": "^6.7.0",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.63.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
